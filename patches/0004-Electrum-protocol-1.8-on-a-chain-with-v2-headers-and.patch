diff --git a/src/test/java/com/sparrowwallet/frigate/electrum/ProtocolV2Test.java b/src/test/java/com/sparrowwallet/frigate/electrum/ProtocolV2Test.java
new file mode 100644
index 0000000..d3c992f
--- /dev/null
+++ b/src/test/java/com/sparrowwallet/frigate/electrum/ProtocolV2Test.java
@@ -0,0 +1,139 @@
+package com.sparrowwallet.frigate.electrum;
+
+import com.google.common.net.HostAndPort;
+import com.sparrowwallet.frigate.io.Protocol;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.net.URI;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * Negotiation on a chain with v2 headers: 1.8 only toward wallets, a range reaching 1.8 toward the backend, and headers refused to a
+ * session below 1.8. On any other chain, negotiation is upstream's.
+ */
+public class ProtocolV2Test {
+    private final AtomicBoolean v2 = new AtomicBoolean(true);
+
+    @BeforeEach
+    public void reset() {
+        BackendChainCheck.setState(BackendChainCheck.State.UNKNOWN);
+    }
+
+    @AfterEach
+    public void after() {
+        BackendChainCheck.setState(BackendChainCheck.State.UNKNOWN);
+    }
+
+    private ElectrumServerService service(ElectrumTransport backend) {
+        ElectrumServerService service = new ElectrumServerService(null, null, null, backend);
+        service.setChainHasV2Headers(v2::get);
+        return service;
+    }
+
+    @Test
+    public void v2ChainNegotiatesOnly18() throws Exception {
+        assertEquals("1.8", service(null).getServerVersion("test", "1.8").get(1));
+        assertEquals("1.8", service(null).getServerVersion("test", List.of("1.3", "1.8")).get(1));
+        assertEquals("1.8", service(null).getServerVersion("test", List.of("1.4", "2.0")).get(1));
+        assertThrows(HeaderVersionRefusedException.class, () -> service(null).getServerVersion("test", List.of("1.4", "1.6")));
+        assertThrows(HeaderVersionRefusedException.class, () -> service(null).getServerVersion("test", "1.4"));
+        assertThrows(HeaderVersionRefusedException.class, () -> service(null).getServerVersion("test", List.of("1.9", "2.0")));
+    }
+
+    @Test
+    public void otherChainsNegotiateAsUpstream() throws Exception {
+        v2.set(false);
+        assertEquals("1.4.2", service(null).getServerVersion("test", List.of("1.3", "1.8")).get(1));
+        assertEquals("1.4", service(null).getServerVersion("test", "1.4").get(1));
+    }
+
+    @Test
+    public void headersRefusedBelow18OnV2Chain() throws Exception {
+        v2.set(false);
+        ElectrumServerService service = service(null);
+        service.getServerVersion("test", "1.4");
+        //the chain crosses its activation height under the session
+        v2.set(true);
+        assertThrows(HeaderVersionRefusedException.class, service::subscribeHeaders);
+        assertThrows(HeaderVersionRefusedException.class, () -> service.getBlockHeader(1, null));
+        assertThrows(HeaderVersionRefusedException.class, () -> service.getBlockHeaders(1, 1, null));
+    }
+
+    @Test
+    public void headersServedAt18OnV2Chain() throws Exception {
+        ElectrumServerService service = service(null);
+        service.getServerVersion("test", List.of("1.3", "1.8"));
+        //past the version rule: with no node configured, the method itself is what refuses
+        assertThrows(UnsupportedOperationException.class, service::subscribeHeaders);
+    }
+
+    @Test
+    public void backendAskedForARangeReaching18() throws Exception {
+        try(FakeElectrumBackend backend = new FakeElectrumBackend()) {
+            //privkeyio's Fulcrum stops at 1.6, Electrs Pruned at 1.8 on this chain: either way the client is told 1.8
+            for(String backendMax : List.of("1.6", "1.8")) {
+                backend.setMaxProtocolVersion(backendMax);
+                URI uri = URI.create(backend.getUrl());
+                try(ElectrumTransport transport = new ElectrumTransport(HostAndPort.fromParts(uri.getHost(), uri.getPort()), Protocol.TCP, new Object())) {
+                    transport.connect();
+                    Thread.ofVirtual().start(transport::readInputLoop);
+                    assertEquals("1.8", service(transport).getServerVersion("test", List.of("1.3", "1.8")).get(1));
+                }
+            }
+            assertEquals(2, backend.getVersionRequests().size());
+            for(var request : backend.getVersionRequests()) {
+                assertEquals("1.4", request.path(0).asText());
+                assertEquals("1.8", request.path(1).asText());
+            }
+        }
+    }
+
+    @Test
+    public void backendOnAnotherChainRefusesWallets() {
+        BackendChainCheck.setState(BackendChainCheck.State.DIFFERENT);
+        try(FakeElectrumBackend backend = new FakeElectrumBackend()) {
+            URI uri = URI.create(backend.getUrl());
+            try(ElectrumTransport transport = new ElectrumTransport(HostAndPort.fromParts(uri.getHost(), uri.getPort()), Protocol.TCP, new Object())) {
+                transport.connect();
+                Thread.ofVirtual().start(transport::readInputLoop);
+                assertThrows(BackendChainMismatchException.class, () -> service(transport).getServerVersion("test", List.of("1.3", "1.8")));
+                v2.set(false);
+                assertThrows(BackendChainMismatchException.class, () -> service(transport).getServerVersion("test", "1.4"));
+            }
+        } catch(Exception e) {
+            fail(e);
+        }
+    }
+
+    @Test
+    public void featuresReport18AndForkPointOnV2Chain() throws Exception {
+        ServerFeatures features = new ServerFeatures(null, "00", "sha256", "x", "1.6", "1.4", null, null,
+                ServerFeatures.Blake2bFork.of(961640, "0000000000000050c1e5f69672f459293be14f46e5a494e7a8c8541396f18eeb"));
+        ServerFeatures result = features.withProtocol("1.8", "1.8");
+        assertEquals("1.8", result.protocol_min());
+        assertEquals("1.8", result.protocol_max());
+        assertEquals(961640, result.blake2b_fork().height());
+        assertEquals(164, result.blake2b_fork().header_bytes());
+        assertEquals("blake2b", result.blake2b_fork().block_hash());
+        assertEquals(961640, result.withHosts(java.util.Map.of()).withSilentPayments(List.of(0)).blake2b_fork().height());
+    }
+
+    @Test
+    public void backendForkPointPassesThroughJson() throws Exception {
+        com.fasterxml.jackson.databind.ObjectMapper mapper = new com.fasterxml.jackson.databind.ObjectMapper();
+        String backend = "{\"genesis_hash\":\"00\",\"hash_function\":\"sha256\",\"protocol_max\":\"1.8\",\"protocol_min\":\"1.4\",\"server_version\":\"Fulcrum 2.1.4\","
+                + "\"blake2b_fork\":{\"height\":961640,\"hash\":\"0000000000000050c1e5f69672f459293be14f46e5a494e7a8c8541396f18eeb\",\"header_bytes\":164,\"block_hash\":\"blake2b\"},\"dsproof\":false}";
+        ServerFeatures features = mapper.readValue(backend, ServerFeatures.class);
+        assertEquals(961640, features.blake2b_fork().height());
+        String out = mapper.writeValueAsString(features.withSilentPayments(List.of(0)));
+        assertTrue(out.contains("\"blake2b_fork\":{\"height\":961640"), out);
+
+        String sha256 = "{\"genesis_hash\":\"00\",\"protocol_max\":\"1.4\",\"protocol_min\":\"1.4\"}";
+        assertFalse(mapper.writeValueAsString(mapper.readValue(sha256, ServerFeatures.class)).contains("blake2b_fork"));
+    }
+}
