--- /dev/null
+++ b/src/main/java/com/sparrowwallet/frigate/electrum/HeaderVersionRefusedException.java
@@ -0,0 +1,25 @@
+package com.sparrowwallet.frigate.electrum;
+
+import com.github.arteam.simplejsonrpc.core.annotation.JsonRpcError;
+import com.github.arteam.simplejsonrpc.core.annotation.JsonRpcErrorData;
+
+/**
+ * Refuses a client below protocol 1.8 on a chain with v2 headers, at server.version and wherever headers are served. Such a client
+ * would read 80 bytes of a 164 byte header, compute SHA256d over it, and fail to link the chain in a way it reports as a sync problem
+ * rather than an incompatibility. The rule and the wording follow Electrs Pruned (its patch 0006) and docs/electrum-header-v2.md.
+ */
+@JsonRpcError(code = -32003, message = "This chain uses 164-byte block headers with a BLAKE2b block hash, which a client below protocol 1.8 cannot read. "
+        + "Refusing rather than serving headers it would misinterpret. Use a wallet that supports Electrum protocol 1.8.")
+public class HeaderVersionRefusedException extends Exception {
+    @JsonRpcErrorData
+    private final String version;
+
+    public HeaderVersionRefusedException(String version) {
+        super("client at protocol " + version + " refused on a chain with v2 headers");
+        this.version = version;
+    }
+
+    public String getVersion() {
+        return version;
+    }
+}
