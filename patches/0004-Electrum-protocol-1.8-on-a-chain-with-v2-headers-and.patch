+    private volatile ServerFeatures.Blake2bFork forkPoint;
+    private volatile String forkPointTip;
+
+    /**
+     * The first v2 header on the node's chain, in the shape Electrs Pruned and Fulcrum Pruned report in server.features, for a backend
+     * that does not report it. Found by binary search over the node's headers rather than compiled in, so a regtest activation height
+     * is right too; cached against the tip, and kept while the header at its height is unchanged (a header commits to every header
+     * below it, so a reorg at or below the fork point changes it).
+     *
+     * @return the fork point, or null if the chain has no v2 header
+     */
+    public ServerFeatures.Blake2bFork getBlake2bForkPoint() {
+        ElectrumBlockHeader current = tip;
+        if(current == null || !current.isV2()) {
+            return null;
+        }
+        ServerFeatures.Blake2bFork cached = forkPoint;
+        if(cached != null && current.hex().equals(forkPointTip)) {
+            return cached;
+        }
+        try {
+            BitcoindClientService service = getBitcoindService();
+            if(cached != null && cached.height() <= current.height() && cached.hash().equals(service.getBlockHash(cached.height()))) {
+                forkPointTip = current.hex();
+                return cached;
+            }
+            int low = 0, high = current.height();
+            while(low < high) {
+                int mid = low + (high - low) / 2;
+                if(ElectrumBlockHeader.isV2(service.getBlockHeader(service.getBlockHash(mid), false))) {
+                    high = mid;
+                } else {
+                    low = mid + 1;
+                }
+            }
+            //the search assumes every header from the first v2 one on is v2, which is how the chain activates; report only a real switch
+            boolean predecessorLegacy = low == 0 || !ElectrumBlockHeader.isV2(service.getBlockHeader(service.getBlockHash(low - 1), false));
+            ServerFeatures.Blake2bFork found = predecessorLegacy ? ServerFeatures.Blake2bFork.of(low, service.getBlockHash(low)) : null;
+            forkPoint = found;
+            forkPointTip = current.hex();
+            return found;
+        } catch(RuntimeException e) {
+            log.warn("Could not find the BLAKE2b fork point", e);
+            return null;
+        }
+    }
