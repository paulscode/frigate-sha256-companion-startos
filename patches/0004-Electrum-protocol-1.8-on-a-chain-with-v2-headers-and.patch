     @Override
     public void notifyHeaders(ElectrumBlockHeader electrumBlockHeader) {
+        Version negotiated = electrumServerService.getNegotiatedVersion();
+        if(electrumBlockHeader.isV2() && (negotiated == null || negotiated.compareTo(ElectrumServerService.PROTOCOL_VERSION_V2) < 0)) {
+            //the chain crossed its activation height under a client that negotiated below 1.8: disconnect it rather than send a header
+            //it would misread. It reconnects into the refusal at server.version, which says why
+            log.info("Disconnecting a client at protocol " + (negotiated == null ? "(unnegotiated)" : negotiated.get()) + ": the chain tip at height "
+                    + electrumBlockHeader.height() + " is a v2 header, which it cannot read");
+            Thread.ofVirtual().name("ElectrumDisconnect-" + System.identityHashCode(this)).start(() -> closeClientSocket(true));
+            return;
+        }
         notifier.notify(() -> notificationService.notifyHeaders(electrumBlockHeader));
     }
 
