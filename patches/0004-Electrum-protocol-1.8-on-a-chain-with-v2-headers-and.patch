diff --git a/src/main/java/com/sparrowwallet/frigate/electrum/BackendChainCheck.java b/src/main/java/com/sparrowwallet/frigate/electrum/BackendChainCheck.java
new file mode 100644
index 0000000..5aee7b0
--- /dev/null
+++ b/src/main/java/com/sparrowwallet/frigate/electrum/BackendChainCheck.java
@@ -0,0 +1,135 @@
+package com.sparrowwallet.frigate.electrum;
+
+import com.github.arteam.simplejsonrpc.client.JsonRpcClient;
+import com.sparrowwallet.frigate.bitcoind.BitcoindClient;
+import com.sparrowwallet.frigate.io.Server;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * Checks that the backend Electrum server follows the same chain as Frigate's node, by comparing one recent header byte for byte:
+ * the backend's blockchain.block.header against the node's getblockheader &lt;hash&gt; false at the same height. Two chains that share
+ * history (the SHA256 chain and the BLAKE2b chain share every block below 961640) differ in every header above their split, so a
+ * recent one settles it, with no hashing and no knowledge of either chain.
+ *
+ * Runs at startup and then periodically, on a connection of its own, and records the answer. Sessions consult the answer at
+ * server.version: a backend on another chain refuses wallets with a reason, while a backend that could not be checked (unreachable,
+ * or still indexing below the height asked for) is not held against them, since its own errors already say what is wrong.
+ */
+public final class BackendChainCheck {
+    private static final Logger log = LoggerFactory.getLogger(BackendChainCheck.class);
+
+    /** How far below the node's tip to compare, so a backend a block or two behind still has the header. */
+    static final int DEPTH = 6;
+    private static final long INTERVAL_MINUTES = 10;
+    private static final long REQUEST_TIMEOUT_MILLIS = TimeUnit.SECONDS.toMillis(60);
+
+    public enum State { UNKNOWN, SAME, DIFFERENT }
+
+    private static volatile State state = State.UNKNOWN;
+    private static volatile Thread thread;
+
+    private BackendChainCheck() {}
+
+    public static State getState() {
+        return state;
+    }
+
+    static void setState(State newState) {
+        state = newState;
+    }
+
+    public static void requireSameChain() throws BackendChainMismatchException {
+        if(state == State.DIFFERENT) {
+            throw new BackendChainMismatchException("backend on a different chain");
+        }
+    }
+
+    public static synchronized void start(BitcoindClient bitcoindClient, Server backend) {
+        if(thread != null || bitcoindClient == null || backend == null) {
+            return;
+        }
+        thread = Thread.ofVirtual().name("BackendChainCheck").start(() -> {
+            while(!Thread.currentThread().isInterrupted()) {
+                record(checkOnce(bitcoindClient, backend));
+                try {
+                    TimeUnit.MINUTES.sleep(INTERVAL_MINUTES);
+                } catch(InterruptedException e) {
+                    return;
+                }
+            }
+        });
+    }
+
+    public static synchronized void stop() {
+        if(thread != null) {
+            thread.interrupt();
+            thread = null;
+        }
+    }
+
+    record Result(State state, String detail) {}
+
+    private static void record(Result result) {
+        State previous = state;
+        state = result.state() == State.UNKNOWN && previous != State.UNKNOWN ? previous : result.state();
+        switch(result.state()) {
+            case SAME -> {
+                if(previous != State.SAME) {
+                    log.info("Backend chain check: the Electrum backend follows the node's chain (" + result.detail() + ")");
+                }
+            }
+            case DIFFERENT -> log.error("Backend chain check FAILED: the Electrum backend follows a different chain from the node (" + result.detail()
+                    + "). Wallets are refused until it is pointed at the same node.");
+            case UNKNOWN -> log.warn("Backend chain check could not run: " + result.detail());
+        }
+    }
+
+    static Result checkOnce(BitcoindClient bitcoindClient, Server backend) {
+        ElectrumTransport transport = new ElectrumTransport(backend.getHostAndPort(), backend.getProtocol(), new Object(), REQUEST_TIMEOUT_MILLIS);
+        try {
+            transport.connect();
+            Thread reader = Thread.ofVirtual().name("BackendChainCheckReader").start(transport::readInputLoop);
+            try {
+                ElectrumBackendService service = new JsonRpcClient(transport).onDemand(ElectrumBackendService.class);
+                service.getServerVersion("Frigate chain check", List.of(ElectrumServerService.MIN_VERSION.get(), ElectrumServerService.PROTOCOL_VERSION_V2.get()));
+                return compare(bitcoindClient, service);
+            } finally {
+                transport.close();
+                reader.interrupt();
+            }
+        } catch(Exception e) {
+            return new Result(State.UNKNOWN, "could not ask the backend at " + backend + " (" + e.getMessage() + ")");
+        }
+    }
+
+    static Result compare(BitcoindClient bitcoindClient, ElectrumBackendService service) {
+        ElectrumBlockHeader tip = bitcoindClient.getTip();
+        if(tip == null) {
+            return new Result(State.UNKNOWN, "the node has no tip yet");
+        }
+        int height = Math.max(0, tip.height() - DEPTH);
+        String nodeHeader = bitcoindClient.getBitcoindService().getBlockHeader(bitcoindClient.getBitcoindService().getBlockHash(height), false);
+        String backendHeader;
+        try {
+            Object answer = service.getBlockHeader(height);
+            backendHeader = answer instanceof String hex ? hex : null;
+        } catch(RuntimeException e) {
+            return new Result(State.UNKNOWN, "the backend has no header at height " + height + " yet (" + e.getMessage() + ")");
+        }
+        if(backendHeader == null) {
+            return new Result(State.UNKNOWN, "the backend answered blockchain.block.header " + height + " with something other than a header");
+        }
+        if(backendHeader.equalsIgnoreCase(nodeHeader)) {
+            return new Result(State.SAME, "header at height " + height + " matches");
+        }
+        return new Result(State.DIFFERENT, "header at height " + height + " is " + abbreviate(backendHeader) + " on the backend and " + abbreviate(nodeHeader) + " on the node");
+    }
+
+    private static String abbreviate(String hex) {
+        return hex.length() <= 24 ? hex : hex.substring(0, 24) + "...(" + hex.length() / 2 + " bytes)";
+    }
+}
