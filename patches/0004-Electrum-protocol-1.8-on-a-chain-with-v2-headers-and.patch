+package com.sparrowwallet.frigate.electrum;
+
+import com.github.arteam.simplejsonrpc.core.annotation.JsonRpcError;
+
+/**
+ * The backend Electrum server serves a different chain from Frigate's node, so its address history would belong to one chain and
+ * Frigate's Silent Payments to another. Wallets are refused until the two agree.
+ */
+@JsonRpcError(code = -32603, message = "This server's Electrum backend follows a different chain from its Bitcoin node. Point the backend at the same node.")
+public class BackendChainMismatchException extends Exception {
+    public BackendChainMismatchException(String message) {
+        super(message);
+    }
+}
