+     * @return the transactions by txid, or null if the backfill stopped first
+     */
+    private Map<Sha256Hash, Transaction> lookUpTransactions(Set<Sha256Hash> txids) {
+        if(txids.isEmpty()) {
+            return Map.of();
+        }
+        if(backend == null) {
+            throw new IllegalStateException("no Electrum backend is configured to look up the coins block transactions spend");
+        }
+        Map<Sha256Hash, Future<Transaction>> futures = new LinkedHashMap<>();
+        for(Sha256Hash txid : txids) {
+            futures.put(txid, lookupPool.submit(() -> lookUpTransaction(txid)));
+        }
+        Map<Sha256Hash, Transaction> found = new HashMap<>();
+        try {
+            for(Map.Entry<Sha256Hash, Future<Transaction>> entry : futures.entrySet()) {
+                while(true) {
+                    if(stopped) {
+                        return null;
+                    }
+                    try {
+                        Transaction tx = entry.getValue().get(1, TimeUnit.SECONDS);
+                        if(tx == null) {
+                            return null;
+                        }
+                        found.put(entry.getKey(), tx);
