+package com.sparrowwallet.frigate.bitcoind;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.HexFormat;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * The scriptPubKey cache keeps witness v2 to v16 programs, so BIP352's rule to skip a transaction spending one still applies to a
+ * prevout read from the cache.
+ */
+public class FutureWitnessProgramTest {
+    private static boolean future(String hex) {
+        return BitcoindClient.isFutureWitnessProgram(HexFormat.of().parseHex(hex));
+    }
+
+    @Test
+    public void recognisesVersionsTwoToSixteen() {
+        assertTrue(future("5220" + "11".repeat(32)));
+        assertTrue(future("6002" + "aaaa"));
+        assertTrue(future("5528" + "22".repeat(40)));
+    }
+
+    @Test
+    public void refusesEverythingElse() {
+        assertFalse(future("0014" + "11".repeat(20)), "v0");
+        assertFalse(future("5120" + "11".repeat(32)), "v1 (taproot) is cached as itself already");
+        assertFalse(future("5201" + "aa"), "a 1 byte program");
+        assertFalse(future("5229" + "22".repeat(41)), "a 41 byte program");
+        assertFalse(future("5220" + "11".repeat(31)), "a push longer than the script");
+        assertFalse(future("6a24aa21a9ed" + "00".repeat(32)), "OP_RETURN");
+    }
+}
