@@ -0,0 +1,116 @@
+package com.sparrowwallet.frigate.bitcoind;
+
+import com.sparrowwallet.drongo.protocol.Block;
+import com.sparrowwallet.drongo.protocol.Transaction;
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.HexFormat;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * Block 980821 on the BLAKE2b chain: a v2 (164 byte) header, segwit and taproot spends, and a witness commitment. A block fetched from
+ * peers is checked against its header before its transactions are used.
+ */
+public class BackfillVerifyTest {
+    private static final String HASH = "00000000000000004918e0727c94c4c2a5507f00b646e5d10c3664ba76485910";
+
+    private static byte[] blockBytes() throws IOException {
+        try(InputStream in = BackfillVerifyTest.class.getResourceAsStream("block-980821.hex")) {
+            return HexFormat.of().parseHex(new String(in.readAllBytes(), StandardCharsets.US_ASCII).trim());
+        }
+    }
+
+    @Test
+    public void acceptsTheRealBlock() throws IOException {
+        Block block = new Block(blockBytes());
+        assertTrue(block.getBlockHeader().isV2());
+        assertEquals(HASH, block.getHash().toString());
+        assertDoesNotThrow(() -> Backfill.verifyBlock(block, HASH));
+    }
+
+    @Test
+    public void refusesAnotherBlockHash() throws IOException {
+        Block block = new Block(blockBytes());
+        Exception e = assertThrows(IllegalStateException.class, () -> Backfill.verifyBlock(block, "00".repeat(32)));
+        assertTrue(e.getMessage().contains("hashes to"));
+    }
+
+    @Test
+    public void refusesAChangedWitness() throws IOException {
+        byte[] bytes = blockBytes();
+        //the last byte of the last witness item of a segwit transaction: before its 4 byte locktime. It changes the wtxid, not the txid
+        Transaction segwit = segwitTransaction(new Block(bytes));
+        byte[] serialized = segwit.bitcoinSerialize();
+        int offset = indexOf(bytes, serialized);
+        assertTrue(offset > 0);
+        bytes[offset + serialized.length - 5] ^= 0x01;
+
+        Block tampered = new Block(bytes);
+        assertEquals(segwit.getTxId(), segwitTransaction(tampered).getTxId());
+        Exception e = assertThrows(IllegalStateException.class, () -> Backfill.verifyBlock(tampered, HASH));
+        assertTrue(e.getMessage().contains("witness commitment"), e.getMessage());
+    }
+
+    @Test
+    public void refusesAChangedTransaction() throws IOException {
+        byte[] bytes = blockBytes();
+        Transaction segwit = segwitTransaction(new Block(bytes));
+        byte[] serialized = segwit.bitcoinSerialize();
+        int offset = indexOf(bytes, serialized);
+        //the locktime, which the txid covers
+        bytes[offset + serialized.length - 1] ^= 0x01;
+
+        Block tampered = new Block(bytes);
+        Exception e = assertThrows(IllegalStateException.class, () -> Backfill.verifyBlock(tampered, HASH));
+        assertTrue(e.getMessage().contains("Merkle root"), e.getMessage());
+    }
+
+    @Test
+    public void refusesASixtyFourByteTransaction() {
+        //a coinbase, then a transaction of exactly 64 bytes: the shape of a Merkle inner node passed off as a leaf
+        HexFormat hex = HexFormat.of();
+        String coinbase = "01000000" + "01" + "00".repeat(32) + "ffffffff" + "02" + "5100" + "ffffffff" + "01" + "0000000000000000" + "00" + "00000000";
+        String sixtyFour = "01000000" + "01" + "11".repeat(32) + "00000000" + "04" + "51515151" + "ffffffff" + "01" + "0000000000000000" + "00" + "00000000";
+        assertEquals(64, sixtyFour.length() / 2);
+        byte[] bytes = hex.parseHex("00000020" + "00".repeat(32) + "00".repeat(32) + "00000000" + "ffff7f20" + "00000000" + "02" + coinbase + sixtyFour);
+        Block block = new Block(bytes);
+        Exception e = assertThrows(IllegalStateException.class, () -> Backfill.verifyBlock(block, block.getHash().toString()));
+        assertTrue(e.getMessage().contains("64 byte"), e.getMessage());
+    }
+
+    @Test
+    public void merkleRootOfOneLeafIsTheLeaf() {
+        byte[] leaf = new byte[32];
+        leaf[0] = 7;
+        assertArrayEquals(leaf, Backfill.merkleRoot(List.of(leaf)));
+    }
+
+    @Test
+    public void formatsDurations() {
+        assertEquals("1m", Backfill.formatDuration(5));
+        assertEquals("2h 5m", Backfill.formatDuration(2 * 3600 + 300));
+        assertEquals("3d 4h", Backfill.formatDuration(3 * 86400 + 4 * 3600 + 10));
+    }
+
+    private static Transaction segwitTransaction(Block block) {
+        return block.getTransactions().stream().skip(1).filter(Transaction::hasWitnesses).findFirst().orElseThrow();
+    }
+
+    private static int indexOf(byte[] haystack, byte[] needle) {
+        outer:
+        for(int i = 0; i <= haystack.length - needle.length; i++) {
+            for(int j = 0; j < needle.length; j++) {
+                if(haystack[i + j] != needle[j]) {
+                    continue outer;
+                }
+            }
+            return i;
+        }
+        return -1;
+    }
+}
