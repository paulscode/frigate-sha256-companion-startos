+                        "ON CONFLICT (singleton) DO UPDATE SET target = excluded.target, next = excluded.next, end_height = excluded.end_height")) {
+                    ps.setInt(1, job.target());
+                    ps.setInt(2, job.next());
+                    ps.setInt(3, job.end());
+                    return ps.executeUpdate();
+                }
+            });
+        } catch(Exception e) {
+            throw new IllegalStateException("Error writing the backfill state", e);
+        }
+    }
+
+    public void clearBackfillJob() {
+        try {
+            dbManager.executeWrite(connection -> {
+                try(Statement stmt = connection.createStatement()) {
+                    return stmt.executeUpdate("DELETE FROM " + BACKFILL_TABLE);
+                }
+            });
+        } catch(Exception e) {
+            throw new IllegalStateException("Error clearing the backfill state", e);
+        }
+    }
+
+    /**
+     * Adds one backfilled block, below where the index started, and advances the backfill past it, in one transaction: a stop or crash
+     * leaves either the whole block and the advanced position or neither. Any rows already at this height (from an abandoned backfill
+     * over the same blocks) are replaced, so adding a block twice is harmless. The indexed-block marker, which tracks the tip, is not
+     * touched.
+     */
+    public void addBackfillBlock(int height, Map<BlockTransaction, byte[]> transactions, BackfillJob job) {
+        if(height >= job.end() || height < job.target()) {
+            throw new IllegalArgumentException("Block " + height + " is outside the backfill range " + job.target() + " to " + (job.end() - 1));
+        }
+        try {
+            dbManager.executeWrite(connection -> {
+                boolean prevAutoCommit = connection.getAutoCommit();
+                connection.setAutoCommit(false);
+                try {
+                    try(PreparedStatement delete = connection.prepareStatement("DELETE FROM " + TWEAK_TABLE + " WHERE height = ?")) {
+                        delete.setInt(1, height);
+                        delete.execute();
+                    }
+                    if(!transactions.isEmpty()) {
+                        try(PreparedStatement insert = connection.prepareStatement("INSERT INTO " + TWEAK_TABLE + " (txid, height, tweak_key, outputs) VALUES (?, ?, ?, ?)")) {
+                            for(BlockTransaction blkTx : transactions.keySet()) {
+                                if(blkTx.getHeight() != height) {
+                                    throw new SQLException("Transaction " + blkTx.getHash() + " is at height " + blkTx.getHeight() + ", not " + height);
+                                }
+                                long[] prefixes = getHashPrefixes(transactions, blkTx);
+                                Long[] boxed = new Long[prefixes.length];
+                                for(int i = 0; i < prefixes.length; i++) {
+                                    boxed[i] = prefixes[i];
+                                }
+                                insert.setBytes(1, blkTx.getTransaction().getTxId().getBytes());
+                                insert.setInt(2, height);
+                                insert.setBytes(3, transactions.get(blkTx));
+                                insert.setArray(4, connection.createArrayOf("BIGINT", boxed));
+                                insert.addBatch();
+                            }
+                            insert.executeBatch();
+                        }
+                    }
+                    try(PreparedStatement ps = connection.prepareStatement("INSERT INTO " + BACKFILL_TABLE + " (target, next, end_height) VALUES (?, ?, ?) " +
+                            "ON CONFLICT (singleton) DO UPDATE SET target = excluded.target, next = excluded.next, end_height = excluded.end_height")) {
+                        ps.setInt(1, job.target());
+                        ps.setInt(2, height + 1);
+                        ps.setInt(3, job.end());
+                        ps.executeUpdate();
+                    }
+                    connection.commit();
+                    return true;
+                } catch(SQLException e) {
+                    connection.rollback();
+                    throw e;
+                } finally {
+                    connection.setAutoCommit(prevAutoCommit);
+                }
+            });
+        } catch(Exception e) {
+            throw new IllegalStateException("Error adding backfilled block " + height + " to the index", e);
+        }
+    }
+
+    int countTweakRows(int fromHeight, int toHeight) {
+        try {
+            return dbManager.executeRead(connection -> {
+                try(PreparedStatement statement = connection.prepareStatement("SELECT COUNT(*) FROM " + TWEAK_TABLE + " WHERE height >= ? AND height <= ?")) {
+                    statement.setInt(1, fromHeight);
+                    statement.setInt(2, toHeight);
+                    ResultSet resultSet = statement.executeQuery();
+                    return resultSet.next() ? resultSet.getInt(1) : 0;
+                }
+            });
+        } catch(Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /**
+     * @return the first block this index covers, as recorded beside the database, or -1 if it is not recorded
+     */
+    public int readStartHeight() {
+        if(dbManager instanceof MemoryDbManager) {
+            return -1;
+        }
+        File file = new File(Storage.getFrigateDbDir(), START_HEIGHT_FILENAME);
+        try {
+            return file.exists() ? Integer.parseInt(Files.readString(file.toPath()).trim()) : -1;
+        } catch(IOException | NumberFormatException e) {
+            log.warn("Could not read " + file, e);
+            return -1;
+        }
+    }
+
+    /**
+     * Records a new first block for this index, once a backfill has filled every block from it up to the old one. Written to a new file
+     * that then replaces the old, so a crash leaves one or the other.
+     */
+    public void writeStartHeight(int startHeight) {
+        if(dbManager instanceof MemoryDbManager) {
+            return;
+        }
+        File file = new File(Storage.getFrigateDbDir(), START_HEIGHT_FILENAME);
+        File tmp = new File(Storage.getFrigateDbDir(), START_HEIGHT_FILENAME + ".tmp");
+        try {
+            Files.writeString(tmp.toPath(), startHeight + "\n");
+            Files.move(tmp.toPath(), file.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING, java.nio.file.StandardCopyOption.ATOMIC_MOVE);
+        } catch(IOException e) {
+            throw new IllegalStateException("Could not write " + file, e);
+        }
+    }
+
