@@ -0,0 +1,117 @@
+package com.sparrowwallet.frigate.bitcoind;
+
+import com.sparrowwallet.drongo.protocol.Sha256Hash;
+import com.sparrowwallet.frigate.Frigate;
+import com.sparrowwallet.frigate.index.Index;
+import com.sparrowwallet.frigate.io.Config;
+import com.sparrowwallet.frigate.io.Server;
+import com.sparrowwallet.frigate.io.Storage;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Path;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * Which backfill runs, from the configured block and the recorded state.
+ */
+public class BackfillJobTest {
+    @TempDir
+    Path tempDir;
+
+    private String previousHome;
+    private Index index;
+
+    @BeforeEach
+    public void setUp() {
+        previousHome = System.getProperty(Frigate.APP_HOME_PROPERTY);
+        System.setProperty(Frigate.APP_HOME_PROPERTY, tempDir.resolve("home").toString());
+        resetExtensionFile();
+        Config config = new Config();
+        config.getDatabase().setUrl("jdbc:duckdb:" + tempDir.resolve("frigate.duckdb"));
+        Config.setInstance(config);
+        index = new Index(1000, false, 1000);
+        //an index that started at 1000, as a pruned node's does
+        assertEquals(1000, index.recordStartHeight(1000));
+        index.addToIndex(1000, Sha256Hash.ZERO_HASH.getBytes(), Map.of());
+    }
+
+    @AfterEach
+    public void tearDown() {
+        index.close();
+        Config.setInstance(null);
+        if(previousHome == null) {
+            System.clearProperty(Frigate.APP_HOME_PROPERTY);
+        } else {
+            System.setProperty(Frigate.APP_HOME_PROPERTY, previousHome);
+        }
+    }
+
+    private Backfill backfill(int minHeight) {
+        return new Backfill(null, index, minHeight, new Server("tcp://127.0.0.1:1"), null, 4);
+    }
+
+    @Test
+    public void startsResumesAndReplaces() {
+        assertNull(backfill(0).resolveJob(null));
+        assertNull(index.getBackfillJob());
+
+        Index.BackfillJob job = backfill(0).resolveJob(900);
+        assertEquals(new Index.BackfillJob(900, 900, 1000), job);
+        assertEquals(job, index.getBackfillJob());
+
+        index.addBackfillBlock(900, Map.of(), job);
+        assertEquals(new Index.BackfillJob(900, 901, 1000), backfill(0).resolveJob(900));
+
+        //turned off: nothing runs, and the position is kept for turning it back on
+        assertNull(backfill(0).resolveJob(null));
+        assertEquals(new Index.BackfillJob(900, 901, 1000), index.getBackfillJob());
+
+        //another block: a new backfill from it
+        assertEquals(new Index.BackfillJob(950, 950, 1000), backfill(0).resolveJob(950));
+    }
+
+    @Test
+    public void clampsToTheLowestUsefulBlock() {
+        assertEquals(new Index.BackfillJob(950, 950, 1000), backfill(950).resolveJob(10));
+        assertNull(backfill(1000).resolveJob(10));
+    }
+
+    @Test
+    public void nothingToDoAtOrAboveTheStart() {
+        index.setBackfillJob(new Index.BackfillJob(900, 950, 1000));
+        assertNull(backfill(0).resolveJob(1000));
+        assertNull(index.getBackfillJob());
+    }
+
+    @Test
+    public void finishesABackfillThatCompletedBeforeAStop() throws Exception {
+        index.setBackfillJob(new Index.BackfillJob(900, 1000, 1000));
+        assertNull(backfill(0).resolveJob(900));
+        assertNull(index.getBackfillJob());
+        assertEquals(900, index.readStartHeight());
+        assertEquals("900", java.nio.file.Files.readString(Storage.getFrigateDbDir().toPath().resolve(Index.START_HEIGHT_FILENAME)).trim());
+
+        //and a lower block later fills only the new range
+        assertEquals(new Index.BackfillJob(800, 800, 900), backfill(0).resolveJob(800));
+    }
+
+    /**
+     * Storage extracts the scanning extension once per JVM, under the home of whichever test ran first, which a test before this one
+     * may have deleted with its temporary directory: extract it again under this test's home.
+     */
+    static void resetExtensionFile() {
+        try {
+            java.lang.reflect.Field field = com.sparrowwallet.frigate.io.Storage.class.getDeclaredField("ufsecpExtensionFile");
+            field.setAccessible(true);
+            field.set(null, null);
+            com.sparrowwallet.frigate.io.Storage.getFrigateDbDir().mkdirs();
+        } catch(ReflectiveOperationException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
