+package com.sparrowwallet.frigate.bitcoind;
+
+import com.github.arteam.simplejsonrpc.client.JsonRpcClient;
+import com.github.arteam.simplejsonrpc.client.exception.JsonRpcException;
+import com.sparrowwallet.drongo.Utils;
+import com.sparrowwallet.drongo.protocol.*;
+import com.sparrowwallet.drongo.silentpayments.SilentPaymentUtils;
+import com.sparrowwallet.drongo.wallet.BlockTransaction;
+import com.sparrowwallet.frigate.Frigate;
+import com.sparrowwallet.frigate.electrum.BackendChainCheck;
+import com.sparrowwallet.frigate.electrum.ElectrumBackendService;
+import com.sparrowwallet.frigate.electrum.ElectrumServerService;
+import com.sparrowwallet.frigate.electrum.ElectrumTransport;
+import com.sparrowwallet.frigate.index.Index;
+import com.sparrowwallet.frigate.index.SilentPaymentsBackfillUpdate;
+import com.sparrowwallet.frigate.io.BackendTls;
+import com.sparrowwallet.frigate.io.Config;
+import com.sparrowwallet.frigate.io.Server;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.*;
+import java.util.concurrent.*;
+import java.util.function.Supplier;
+
+/**
+ * Adds blocks below where the index starts, back to a chosen block, for a pruned node that no longer holds them. Opt-in
+ * (index.backfillFromHeight), one block at a time, oldest first, in its own thread once the index has caught up with the tip.
+ *
+ * For each block:
+ * <ol>
+ * <li>the block itself: getblock verbosity 3 if the node still has it with its undo data (an archival node: prevouts included, nothing
+ * more to fetch). Otherwise getblock verbosity 0, which a pruned node's btc-rpc-proxy answers by fetching the block from peers without
+ * storing it; and if the node itself answers (no proxy), getblockfrompeer, then getblock once it has arrived;</li>
+ * <li>checked against the node's own header for that height: hash, Merkle root, and witness commitment, since peers are not trusted
+ * and the input keys come from witness data;</li>
+ * <li>the prevouts of its eligible transactions from the scriptPubKey cache, else from the Electrum backend
+ * (blockchain.transaction.get on the parent), several in flight on a pool of connections, each returned transaction checked against
+ * the txid asked for;</li>
+ * <li>the tweaks written in one transaction with the advanced position, so a stop or crash resumes where it left off.</li>
+ * </ol>
+ * A failure never skips a block: the backfill waits and retries, with a growing delay. Oldest first matters: outputs created inside
+ * the range are in the cache by the time later blocks in it spend them, which is most of the saving the measurements assume.
+ */
+public class Backfill {
+    private static final Logger log = LoggerFactory.getLogger(Backfill.class);
+
+    static final long RETRY_INITIAL_MILLIS = 5_000;
+    static final long RETRY_MAX_MILLIS = 600_000;
+    static final long PEER_WAIT_MILLIS = 30_000;
+    static final long NOTIFY_INTERVAL_MILLIS = 60_000;
+    static final long PROGRESS_LOG_MILLIS = 30_000;
+    static final long CHAIN_CHECK_WAIT_MILLIS = 60_000;
+    static final long BACKEND_REQUEST_TIMEOUT_MILLIS = 180_000;
+    static final long STOP_JOIN_MILLIS = 10_000;
+
+    private static final byte[] WITNESS_COMMITMENT_PREFIX = {0x6a, 0x24, (byte)0xaa, 0x21, (byte)0xa9, (byte)0xed};
+
+    private final BitcoindClient bitcoindClient;
+    private final Index index;
+    private final int minHeight;
+    private final Server backend;
+    private final BackendTls backendTls;
+    private final int inFlight;
+    private final HexFormat hexFormat = HexFormat.of();
+
+    private final Object waitLock = new Object();
+    private volatile boolean stopped;
+    private Thread thread;
+    private ExecutorService lookupPool;
+    private final BlockingQueue<BackendConnection> connections = new LinkedBlockingQueue<>();
+    private final List<BackendConnection> allConnections = new CopyOnWriteArrayList<>();
+
+    Backfill(BitcoindClient bitcoindClient, Index index, int minHeight, Server backend, BackendTls backendTls, int inFlight) {
+        this.bitcoindClient = bitcoindClient;
+        this.index = index;
+        this.minHeight = minHeight;
+        this.backend = backend;
+        this.backendTls = backendTls;
+        this.inFlight = Math.max(1, inFlight);
+    }
+
+    /**
+     * Starts a backfill if one is configured, or if one is recorded (so that turning it off is reported).
+     *
+     * @param minHeight the lowest block worth indexing: Taproot activation on mainnet, as no earlier block can hold a Silent Payment
+     * @return the running backfill, to stop on shutdown, or null if there is nothing to do
+     */
+    public static Backfill start(BitcoindClient bitcoindClient, Index index, int minHeight) {
+        Config.IndexConfig indexConfig = Config.get().getIndex();
+        Config.ServerConfig serverConfig = Config.get().getServer();
+        Server backend = serverConfig.getBackendElectrumServerObj();
+        Backfill backfill = new Backfill(bitcoindClient, index, minHeight, backend, backend == null ? null : BackendTls.fromConfig(serverConfig),
+                indexConfig.getBackfillInFlight());
+        //a fault here (the backfill state unreadable, say) must not keep Frigate from serving the index it has
+        try {
+            Index.BackfillJob job = backfill.resolveJob(indexConfig.getBackfillFromHeight());
+            if(job == null) {
+                return null;
+            }
+            backfill.startThread(job);
+            return backfill;
+        } catch(RuntimeException e) {
+            log.error("Backfill could not start; Frigate runs without it", e);
+            return null;
+        }
+    }
+
+    private void startThread(Index.BackfillJob job) {
+        lookupPool = Executors.newFixedThreadPool(inFlight, runnable -> {
+            Thread t = new Thread(runnable, "BackfillLookup");
+            t.setDaemon(true);
+            return t;
+        });
+        for(int i = 0; i < inFlight; i++) {
+            BackendConnection connection = new BackendConnection();
+            allConnections.add(connection);
+            connections.add(connection);
+        }
+        thread = new Thread(() -> {
+            try {
+                runJob(job);
+            } catch(Throwable t) {
+                if(!stopped) {
+                    log.error("Backfill stopped by an error; it resumes at block " + safeNext() + " when Frigate next starts", t);
+                }
+            } finally {
+                closeConnections();
+                lookupPool.shutdownNow();
+            }
+        }, "Backfill");
+        thread.setDaemon(true);
+        thread.start();
+    }
+
+    private String safeNext() {
+        try {
+            Index.BackfillJob job = index.getBackfillJob();
+            return job == null ? "?" : Integer.toString(job.next());
+        } catch(RuntimeException e) {
+            return "?";
+        }
+    }
+
+    /**
+     * Works out what to do from the configured block and the recorded state: finishes a backfill that completed just before a stop,
+     * resumes one for the same block, or starts a new one. A backfill for another block is replaced; the blocks it added stay in the
+     * index (they are correct, and a later backfill over them replaces them rather than adding them twice).
+     *
+     * @return the backfill to run, or null if there is none
+     */
+    Index.BackfillJob resolveJob(Integer requested) {
+        Index.BackfillJob job = index.getBackfillJob();
+        int start = index.readStartHeight();
+
+        if(job != null && job.isComplete()) {
+            finish(job);
+            start = job.target();
+            job = null;
+        }
+
+        if(requested == null) {
+            if(job != null) {
+                log.info("Backfill is off: the {} blocks it added from block {} are kept, and it resumes at block {} if it is turned back on for block {}",
+                        job.next() - job.target(), job.target(), job.next(), job.target());
+            }
+            return null;
+        }
+
+        int target = Math.max(requested, minHeight);
+        if(start < 0) {
+            log.warn("Backfill waiting: the block this index starts at is not recorded, so there is no range to fill below it. Rebuild the index to record it.");
+            return null;
+        }
+        if(target >= start) {
+            if(job != null) {
+                index.clearBackfillJob();
+            }
+            log.info("Backfill: nothing to do, the index already starts at block {}, at or below block {}", start, target);
+            return null;
+        }
+        if(backend == null && bitcoindClient.isPruned()) {
+            log.warn("Backfill waiting: on a pruned node it looks up the coins old transactions spend through the Electrum backend, and none is configured");
+            return null;
+        }
+
+        if(job != null && job.target() == target && job.end() == start) {
+            log.info("Backfill: resuming at block {}, looking back to block {} ({} of {} blocks left)", job.next(), target, job.end() - job.next(), job.end() - target);
+            return job;
+        }
+
+        job = new Index.BackfillJob(target, target, start);
+        index.setBackfillJob(job);
+        log.info("Backfill: looking back to block {}: {} blocks, {} to {}, below where the index starts", target, start - target, target, start - 1);
+        return job;
+    }
+
+    private void finish(Index.BackfillJob job) {
+        index.writeStartHeight(job.target());
+        index.clearBackfillJob();
+        log.info("Backfill complete: the index now starts at block {}", job.target());
+    }
+
+    void runJob(Index.BackfillJob job) {
+        int total = job.end() - job.target();
+        long startedMillis = System.currentTimeMillis();
+        int startedNext = job.next();
+        long lastLogMillis = startedMillis;
+        long lastNotifyMillis = startedMillis;
+        int notifyFrom = job.next();
+
+        while(!job.isComplete()) {
+            if(stopped) {
+                log.info("Backfill stopping at block {}; it resumes there when Frigate next starts", job.next());
+                notifyWallets(notifyFrom, job.next() - 1);
+                return;
+            }
+            waitWhileBackendOnAnotherChain();
+
+            int height = job.next();
+            Map<BlockTransaction, byte[]> tweaks = retrying("block " + height, () -> getBlockTweaks(height));
+            if(tweaks == null) {
+                continue;
+            }
+            Index.BackfillJob current = job;
+            if(retrying("writing block " + height, () -> { index.addBackfillBlock(height, tweaks, current); return true; }) == null) {
+                continue;
+            }
+            job = new Index.BackfillJob(job.target(), height + 1, job.end());
+
+            long now = System.currentTimeMillis();
+            if(now - lastLogMillis >= PROGRESS_LOG_MILLIS || job.isComplete()) {
+                int done = job.next() - job.target();
+                double rate = (job.next() - startedNext) / Math.max(1.0, (now - startedMillis) / 1000.0);
+                String left = rate > 0 ? ", about " + formatDuration((long)((job.end() - job.next()) / rate)) + " left" : "";
+                log.info("Backfill progress: {} / {} blocks ({}%, height {}){}", done, total, String.format(Locale.ROOT, "%.1f", 100.0 * done / total), height, left);
+                lastLogMillis = now;
+            }
+            if(now - lastNotifyMillis >= NOTIFY_INTERVAL_MILLIS) {
+                notifyWallets(notifyFrom, height);
+                notifyFrom = height + 1;
+                lastNotifyMillis = now;
+            }
+        }
+
+        notifyWallets(notifyFrom, job.end() - 1);
+        finish(job);
+    }
+
+    private void notifyWallets(int from, int to) {
+        if(from <= to) {
+            Frigate.getEventBus().post(new SilentPaymentsBackfillUpdate(from, to));
+        }
+    }
+
+    static String formatDuration(long seconds) {
+        if(seconds < 3600) {
+            return Math.max(1, seconds / 60) + "m";
+        }
+        if(seconds < 86400 * 2) {
+            return (seconds / 3600) + "h " + ((seconds % 3600) / 60) + "m";
+        }
+        return (seconds / 86400) + "d " + ((seconds % 86400) / 3600) + "h";
+    }
+
+    private void waitWhileBackendOnAnotherChain() {
+        boolean logged = false;
+        while(!stopped && backend != null && BackendChainCheck.getState() == BackendChainCheck.State.DIFFERENT) {
+            if(!logged) {
+                log.warn("Backfill waiting: the Electrum backend follows a different chain from the node");
+                logged = true;
+            }
+            sleep(CHAIN_CHECK_WAIT_MILLIS);
+        }
+    }
+
+    /**
+     * Runs a step until it succeeds or the backfill stops, waiting longer after each failure.
+     *
+     * @return the step's result, or null if the backfill stopped first
+     */
+    private <T> T retrying(String what, Supplier<T> step) {
+        long delay = RETRY_INITIAL_MILLIS;
+        while(!stopped) {
+            try {
+                return step.get();
+            } catch(RuntimeException e) {
+                if(stopped) {
+                    return null;
+                }
+                log.warn("Backfill waiting: {} failed ({}), retrying in {}s", what, describe(e), delay / 1000);
+                log.debug("Backfill failure", e);
+                sleep(delay);
+                delay = Math.min(delay * 2, RETRY_MAX_MILLIS);
+            }
+        }
+        return null;
+    }
+
+    private static String describe(Throwable e) {
+        Throwable t = e;
+        while(t.getCause() != null && t.getMessage() == null) {
+            t = t.getCause();
+        }
+        if(t instanceof JsonRpcException jre && jre.getErrorMessage() != null) {
+            return jre.getErrorMessage().getMessage();
+        }
+        return t.getMessage() != null ? t.getMessage() : t.getClass().getSimpleName();
+    }
+
+    /**
+     * @return the tweaks of the block at this height on the node's chain, or null if the backfill stopped first
+     */
+    Map<BlockTransaction, byte[]> getBlockTweaks(int height) {
+        BitcoindClientService service = bitcoindClient.getBitcoindService();
+        String blockHash = service.getBlockHash(height);
+
+        try {
+            VerboseBlock verboseBlock = service.getVerboseBlock(blockHash, 3);
+            Map<BlockTransaction, byte[]> tweaks = bitcoindClient.getVerboseBlockTweaks(height, verboseBlock, hexFormat);
+            if(tweaks != null) {
+                return tweaks;
+            }
+        } catch(JsonRpcException e) {
+            //pruned, or kept without undo data: fetch it
+            log.debug("Block {} is not on the node with its undo data ({}), fetching it", height, describe(e));
+        }
+
+        Block block = fetchBlock(service, blockHash);
+        if(block == null) {
+            return null;
+        }
+        return getTweaks(height, block);
+    }
+
+    /**
+     * @return the block, checked against the node's header, or null if the backfill stopped first
+     */
+    private Block fetchBlock(BitcoindClientService service, String blockHash) {
+        String hex;
+        try {
+            //an I/O error goes up to retrying; the node's own errors are answers
+            hex = (String)service.getBlock(blockHash, 0);
+        } catch(JsonRpcException e) {
+            if(!BitcoindClient.isPrunedBlockError(e)) {
+                throw e;
+            }
+            return fetchBlockFromPeer(service, blockHash);
+        }
+        try {
+            return parseAndVerify(hex, blockHash);
+        } catch(RuntimeException e) {
+            //a block from btc-rpc-proxy that fails the checks came from a bad peer: asking again may reach the same one, so ask the
+            //node's own peers instead
+            log.warn("Backfill: block {} as fetched failed its checks ({}); asking the node's peers for it", blockHash, describe(e));
+            return fetchBlockFromPeer(service, blockHash);
+        }
+    }
+
+    private Block parseAndVerify(String hex, String blockHash) {
+        Block block = parseBlock(hex);
+        verifyBlock(block, blockHash);
+        return block;
+    }
+
+    private Block parseBlock(String hex) {
+        return new Block(hexFormat.parseHex(hex));
+    }
+
+    /**
+     * Asks the node to fetch a pruned block from a peer that serves old blocks, and reads it once it arrives. The node keeps the block
+     * until it next prunes, as it would a new one; it adds no undo data.
+     */
+    private Block fetchBlockFromPeer(BitcoindClientService service, String blockHash) {
+        List<PeerInfo> peers = new ArrayList<>(service.getPeerInfo().stream().filter(PeerInfo::servesHistoricalBlocks).toList());
+        if(peers.isEmpty()) {
+            throw new IllegalStateException("the node has no peer that serves old blocks, to fetch pruned block " + blockHash + " from");
+        }
+        Collections.shuffle(peers);
+        for(PeerInfo peer : peers) {
+            if(stopped) {
+                return null;
+            }
+            try {
+                service.getBlockFromPeer(blockHash, peer.id());
+            } catch(JsonRpcException e) {
+                log.debug("Peer {} was not asked for block {}: {}", peer.id(), blockHash, describe(e));
+                //"Block already downloaded" means it is there to read; anything else, try the next peer
+                if(describe(e) == null || !describe(e).contains("already")) {
+                    continue;
+                }
+            }
+            long deadline = System.currentTimeMillis() + PEER_WAIT_MILLIS;
+            while(!stopped && System.currentTimeMillis() < deadline) {
+                String hex;
+                try {
+                    hex = (String)service.getBlock(blockHash, 0);
+                } catch(JsonRpcException e) {
+                    sleep(1000);
+                    continue;
+                }
+                try {
+                    return parseAndVerify(hex, blockHash);
+                } catch(RuntimeException e) {
+                    log.warn("Backfill: block {} from peer {} failed its checks ({}); trying another peer", blockHash, peer.id(), describe(e));
+                    break;
+                }
+            }
+        }
+        throw new IllegalStateException("no peer sent pruned block " + blockHash);
+    }
+
+    /**
+     * Checks a block fetched from peers against the node's header: the header must hash to the block asked for, and the transactions
+     * must be the ones it commits to, txids through the Merkle root and witness data through the coinbase's witness commitment (BIP141).
+     */
+    static void verifyBlock(Block block, String blockHash) {
+        if(!block.getHash().toString().equals(blockHash)) {
+            throw new IllegalStateException("fetched block hashes to " + block.getHash() + ", not " + blockHash);
+        }
+        List<Transaction> txs = block.getTransactions();
+        if(txs.isEmpty() || !txs.getFirst().isCoinBase()) {
+            throw new IllegalStateException("fetched block " + blockHash + " has no coinbase");
+        }
+
+        List<byte[]> txids = new ArrayList<>(txs.size());
+        Set<Sha256Hash> seen = new HashSet<>();
+        for(Transaction tx : txs) {
+            //a repeated transaction can leave the Merkle root unchanged (CVE-2012-2459), so a block with one is a mutated copy
+            if(!seen.add(tx.getTxId())) {
+                throw new IllegalStateException("fetched block " + blockHash + " repeats transaction " + tx.getTxId());
+            }
+            //a 64 byte transaction can be an inner node of the Merkle tree passed off as a leaf, hiding the transactions below it
+            //behind an unchanged root; Bitcoin Core refuses any block with one (IsBlockMutated)
+            if(tx.bitcoinSerialize(false).length == 64) {
+                throw new IllegalStateException("fetched block " + blockHash + " has a 64 byte transaction " + tx.getTxId());
+            }
+            txids.add(tx.getTxId().getReversedBytes());
+        }
+        if(!Arrays.equals(merkleRoot(txids), block.getBlockHeader().getMerkleRoot().getReversedBytes())) {
+            throw new IllegalStateException("fetched block " + blockHash + " does not match its header's Merkle root");
+        }
+
+        Transaction coinbase = txs.getFirst();
+        byte[] commitment = null;
+        for(TransactionOutput output : coinbase.getOutputs()) {
+            byte[] script = output.getScriptBytes();
+            if(script.length >= 38 && Arrays.equals(Arrays.copyOf(script, WITNESS_COMMITMENT_PREFIX.length), WITNESS_COMMITMENT_PREFIX)) {
+                commitment = Arrays.copyOfRange(script, 6, 38);
+            }
+        }
+        if(commitment == null) {
+            for(Transaction tx : txs) {
+                if(tx.hasWitnesses()) {
+                    throw new IllegalStateException("fetched block " + blockHash + " has witness data but no witness commitment");
+                }
+            }
+            return;
+        }
+
