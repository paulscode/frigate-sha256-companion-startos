+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.nio.file.Path;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+public class IndexBackfillTest {
+    @TempDir
+    Path tempDir;
+
+    private String previousHome;
+
+    @BeforeEach
+    public void setUp() {
+        previousHome = System.getProperty(Frigate.APP_HOME_PROPERTY);
+        System.setProperty(Frigate.APP_HOME_PROPERTY, tempDir.resolve("home").toString());
+        resetExtensionFile();
+        Config config = new Config();
+        config.getDatabase().setUrl("jdbc:duckdb:" + tempDir.resolve("frigate.duckdb"));
+        Config.setInstance(config);
+    }
+
+    @AfterEach
+    public void tearDown() {
+        Config.setInstance(null);
+        if(previousHome == null) {
+            System.clearProperty(Frigate.APP_HOME_PROPERTY);
+        } else {
+            System.setProperty(Frigate.APP_HOME_PROPERTY, previousHome);
+        }
+    }
+
+    private static Map<BlockTransaction, byte[]> block(int height, int count) {
+        Map<BlockTransaction, byte[]> txs = new LinkedHashMap<>();
+        for(int i = 0; i < count; i++) {
+            Transaction tx = new Transaction();
+            tx.setLocktime(height * 100L + i);
+            txs.put(new BlockTransaction(tx.getTxId(), height, null, 0L, tx, null), new byte[64]);
+        }
+        return txs;
+    }
+
+    @Test
+    public void addsBackfilledBlocksBelowTheTipWithoutMovingIt() {
+        Index index = new Index(1000, false, 1000);
+        try {
+            index.addToIndex(1000, Sha256Hash.ZERO_HASH.getBytes(), block(1000, 1));
+            assertNull(index.getBackfillJob());
+
+            Index.BackfillJob job = new Index.BackfillJob(990, 990, 1000);
+            index.setBackfillJob(job);
+            index.addBackfillBlock(990, block(990, 2), job);
+            assertEquals(new Index.BackfillJob(990, 991, 1000), index.getBackfillJob());
+            assertEquals(2, index.countTweakRows(990, 990));
+            assertEquals(1000, index.getLastBlockIndexed());
+
+            //again, as after an abandoned backfill over the same block: replaced, not added twice
+            index.addBackfillBlock(990, block(990, 2), job);
+            assertEquals(2, index.countTweakRows(990, 990));
+
+            index.addBackfillBlock(991, Map.of(), new Index.BackfillJob(990, 991, 1000));
+            assertEquals(new Index.BackfillJob(990, 992, 1000), index.getBackfillJob());
+
+            assertThrows(IllegalArgumentException.class, () -> index.addBackfillBlock(1000, block(1000, 1), job));
+            assertThrows(IllegalArgumentException.class, () -> index.addBackfillBlock(989, block(989, 1), job));
+
+            index.clearBackfillJob();
+            assertNull(index.getBackfillJob());
+            assertEquals(1, index.countTweakRows(1000, 1000));
+        } finally {
+            index.close();
+        }
+    }
+
+    @Test
+    public void keepsTheBackfillAcrossARestart() {
+        Index index = new Index(1000, false, 1000);
+        Index.BackfillJob job = new Index.BackfillJob(990, 990, 1000);
+        index.setBackfillJob(job);
+        index.addBackfillBlock(990, block(990, 1), job);
+        index.close();
+
+        Index restarted = new Index(1000, false, 1000);
+        try {
+            assertEquals(new Index.BackfillJob(990, 991, 1000), restarted.getBackfillJob());
+            assertEquals(1, restarted.countTweakRows(990, 990));
+        } finally {
+            restarted.close();
+        }
+    }
+
+    /**
+     * Storage extracts the scanning extension once per JVM, under the home of whichever test ran first, which a test before this one
+     * may have deleted with its temporary directory: extract it again under this test's home.
+     */
+    static void resetExtensionFile() {
+        try {
+            java.lang.reflect.Field field = com.sparrowwallet.frigate.io.Storage.class.getDeclaredField("ufsecpExtensionFile");
+            field.setAccessible(true);
+            field.set(null, null);
+            com.sparrowwallet.frigate.io.Storage.getFrigateDbDir().mkdirs();
+        } catch(ReflectiveOperationException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
