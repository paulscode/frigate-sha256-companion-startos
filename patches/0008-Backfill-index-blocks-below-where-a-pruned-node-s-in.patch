+    private Transaction lookUpTransaction(Sha256Hash txid) throws InterruptedException {
+        long delay = RETRY_INITIAL_MILLIS;
+        for(int attempt = 1; !stopped; attempt++) {
+            BackendConnection connection = connections.poll(1, TimeUnit.SECONDS);
+            if(connection == null) {
+                continue;
+            }
+            try {
+                Object answer = connection.service().getTransaction(txid.toString(), false);
+                if(!(answer instanceof String hex)) {
+                    throw new IllegalStateException("the backend answered with something other than a transaction");
+                }
+                Transaction tx = new Transaction(hexFormat.parseHex(hex));
+                if(!tx.getTxId().equals(txid)) {
+                    throw new IllegalStateException("the backend returned a transaction that hashes to " + tx.getTxId());
+                }
+                return tx;
+            } catch(Exception e) {
+                if(stopped) {
+                    return null;
+                }
+                connection.close();
+                if(attempt == 1 || delay >= RETRY_MAX_MILLIS) {
+                    log.warn("Backfill waiting: looking up transaction {} on the Electrum backend failed ({}), retrying in {}s", txid, describe(e), delay / 1000);
+                } else {
+                    log.debug("Backfill lookup of {} failed again ({})", txid, describe(e));
+                }
+            } finally {
+                connections.add(connection);
+            }
+            sleep(delay);
+            delay = Math.min(delay * 2, RETRY_MAX_MILLIS);
+        }
+        return null;
+    }
+
+    private void sleep(long millis) {
+        synchronized(waitLock) {
+            if(stopped) {
+                return;
+            }
+            try {
+                waitLock.wait(millis);
+            } catch(InterruptedException e) {
+                //a stop is signalled by the flag, not an interrupt; keeping the interrupt would make every later wait return at once
+            }
+        }
+    }
+
+    public void stop() {
+        stopped = true;
+        synchronized(waitLock) {
+            waitLock.notifyAll();
+        }
+        closeConnections();
+        if(lookupPool != null) {
+            lookupPool.shutdownNow();
+        }
+        if(thread != null) {
+            try {
+                thread.join(STOP_JOIN_MILLIS);
+            } catch(InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+        }
+    }
+
+    private void closeConnections() {
+        allConnections.forEach(BackendConnection::close);
+    }
+
+    /**
+     * One connection to the Electrum backend, opened when first used and again after a failure. Requests on a connection are serial,
+     * so the pool holds one per lookup in flight.
+     */
+    private class BackendConnection {
+        //used by one lookup at a time (it is taken from the pool), and closed from another thread only on a stop, which must not wait
+        //for a connect in progress
+        private volatile ElectrumTransport transport;
+        private volatile Thread reader;
+        private volatile ElectrumBackendService service;
+
+        ElectrumBackendService service() throws Exception {
+            ElectrumBackendService current = service;
+            if(current != null) {
+                return current;
+            }
+            if(stopped) {
+                throw new IllegalStateException("stopped");
+            }
+            ElectrumTransport newTransport = new ElectrumTransport(backend.getHostAndPort(), backend.getProtocol(), new Object(), BACKEND_REQUEST_TIMEOUT_MILLIS, backendTls);
+            transport = newTransport;
+            newTransport.connect();
+            reader = Thread.ofVirtual().name("BackfillBackendReader").start(newTransport::readInputLoop);
+            ElectrumBackendService newService = new JsonRpcClient(newTransport).onDemand(ElectrumBackendService.class);
+            newService.getServerVersion("Frigate backfill", List.of(ElectrumServerService.MIN_VERSION.get(), ElectrumServerService.PROTOCOL_VERSION_V2.get()));
+            service = newService;
+            return newService;
+        }
+
+        void close() {
+            ElectrumTransport closing = transport;
+            Thread closingReader = reader;
+            transport = null;
+            reader = null;
+            service = null;
+            if(closing != null) {
+                try {
+                    closing.close();
+                } catch(Exception e) {
+                    log.debug("Error closing a backfill backend connection", e);
+                }
+            }
+            if(closingReader != null) {
+                closingReader.interrupt();
+            }
+        }
+    }
+}
