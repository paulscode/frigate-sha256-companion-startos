diff --git a/src/main/java/com/sparrowwallet/frigate/io/Storage.java b/src/main/java/com/sparrowwallet/frigate/io/Storage.java
index a0ae9a9..2c87998 100644
--- a/src/main/java/com/sparrowwallet/frigate/io/Storage.java
+++ b/src/main/java/com/sparrowwallet/frigate/io/Storage.java
@@ -28,6 +28,29 @@ public class Storage {
 
     private static File ufsecpExtensionFile;
 
+    /**
+     * Replaces target with bytes so that a crash leaves either the old file or the new one whole: written to tmp, synced to disk,
+     * renamed over target, and the directory synced. tmp is created owner-only, like the files it replaces.
+     */
+    public static void writeDurably(File tmp, File target, byte[] bytes) throws IOException {
+        java.nio.file.Files.deleteIfExists(tmp.toPath());
+        createOwnerOnlyFile(tmp);
+        try(java.nio.channels.FileChannel channel = java.nio.channels.FileChannel.open(tmp.toPath(), java.nio.file.StandardOpenOption.WRITE,
+                java.nio.file.StandardOpenOption.TRUNCATE_EXISTING)) {
+            java.nio.ByteBuffer buffer = java.nio.ByteBuffer.wrap(bytes);
+            while(buffer.hasRemaining()) {
+                channel.write(buffer);
+            }
+            channel.force(true);
+        }
+        java.nio.file.Files.move(tmp.toPath(), target.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING, java.nio.file.StandardCopyOption.ATOMIC_MOVE);
+        try(java.nio.channels.FileChannel dir = java.nio.channels.FileChannel.open(target.getParentFile().toPath(), java.nio.file.StandardOpenOption.READ)) {
+            dir.force(true);
+        } catch(IOException e) {
+            //not every filesystem lets a directory be opened for syncing; the rename itself is still atomic
+        }
+    }
+
     public static synchronized File getUfsecpExtensionFile() {
         if(ufsecpExtensionFile == null) {
             ufsecpExtensionFile = getExtensionFile(UFSECP_EXTENSION_FILENAME);
