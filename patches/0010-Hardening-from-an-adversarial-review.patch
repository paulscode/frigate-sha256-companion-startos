@@ -0,0 +1,72 @@
+package com.sparrowwallet.frigate.io;
+
+import com.sparrowwallet.frigate.ConfigurationException;
+import com.sparrowwallet.frigate.Frigate;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * Files Frigate keeps beside its index, as a crash or a full disk can leave them, and a config.toml that cannot be read.
+ */
+public class DurableFilesTest {
+    @TempDir
+    Path tempDir;
+
+    private String previousHome;
+
+    @BeforeEach
+    public void setUp() {
+        previousHome = System.getProperty(Frigate.APP_HOME_PROPERTY);
+        System.setProperty(Frigate.APP_HOME_PROPERTY, tempDir.resolve("home").toString());
+        Storage.getFrigateDir().mkdirs();
+        Config.setInstance(null);
+    }
+
+    @AfterEach
+    public void tearDown() {
+        Config.setInstance(null);
+        if(previousHome == null) {
+            System.clearProperty(Frigate.APP_HOME_PROPERTY);
+        } else {
+            System.setProperty(Frigate.APP_HOME_PROPERTY, previousHome);
+        }
+    }
+
+    @Test
+    public void aTruncatedRecentBlocksFileDoesNotStopAStart() throws Exception {
+        File file = new File(Storage.getFrigateDir(), "recentblocks");
+        Files.writeString(file.toPath(), "{\n  \"969302\": \"00000000000000000001", StandardCharsets.UTF_8);
+        RecentBlocksMap map = assertDoesNotThrow(() -> new RecentBlocksMap(10));
+        assertNull(map.getTipHeight());
+
+        map.put(969303, "ab".repeat(32));
+        assertEquals("ab".repeat(32), new RecentBlocksMap(10).get(969303), "written whole, and read back");
+        assertFalse(new File(Storage.getFrigateDir(), "recentblocks.tmp").exists());
+    }
+
+    @Test
+    public void writesReplaceTheFileWhole() throws Exception {
+        File target = new File(Storage.getFrigateDir(), "start-height");
+        File tmp = new File(Storage.getFrigateDir(), "start-height.tmp");
+        Storage.writeDurably(tmp, target, "961640\n".getBytes(StandardCharsets.US_ASCII));
+        Storage.writeDurably(tmp, target, "958000\n".getBytes(StandardCharsets.US_ASCII));
+        assertEquals("958000\n", Files.readString(target.toPath()));
+        assertFalse(tmp.exists());
+    }
+
+    @Test
+    public void anUnreadableConfigStopsFrigateWithTheReason() throws Exception {
+        Files.writeString(new File(Storage.getFrigateDir(), "config.toml").toPath(), "[index]\nstartHeight = 99999999999\n");
+        ConfigurationException e = assertThrows(ConfigurationException.class, Config::get);
+        assertTrue(e.getMessage().contains("config.toml"), e.getMessage());
+    }
+}
