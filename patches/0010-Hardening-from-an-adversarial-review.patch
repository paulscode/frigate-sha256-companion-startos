+     * A block fetched with getblockfrompeer is stored on the node until a block file holding it can be pruned, which is not before the
+     * newest block in that file is 288 deep. A fast backfill can so push the node well past its prune target. Wait while it is more
+     * than half again over.
+     */
+    private void waitWhileNodeOverPruneTarget(BitcoindClientService service) {
+        boolean logged = false;
+        while(!stopped) {
+            Map<String, Object> info = service.getBlockchainInfoMap();
+            Object size = info.get("size_on_disk");
+            Object target = info.get("prune_target_size");
+            if(!(size instanceof Number s) || !(target instanceof Number t) || t.longValue() <= 0 || s.longValue() <= t.longValue() * 3 / 2) {
+                return;
+            }
+            if(!logged) {
+                log.warn("Backfill waiting: the node holds {} MB, over its prune target of {} MB, with blocks fetched for the backfill; waiting for it to prune",
+                        s.longValue() / 1_000_000, t.longValue() / 1_000_000);
+                logged = true;
+            }
+            sleep(NODE_DISK_WAIT_MILLIS);
+        }
+    }
