@@ -55,6 +55,16 @@ public class RecentBlocksMap {
         return data.firstKey();
     }
 
+    /**
+     * @return the lowest height recorded, the deepest block a mismatch can be checked against
+     */
+    public synchronized Integer getOldestHeight() {
+        if(data.isEmpty()) {
+            return null;
+        }
+        return data.lastKey();
+    }
+
     private void enforceMaxSize() {
         while(data.size() > maxSize) {
             data.pollLastEntry();
