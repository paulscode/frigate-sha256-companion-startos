+    /**
+     * Waits while the node is behind the index on the same chain, rather than calling the index another chain's: a node restored from
+     * an older copy, or one that lost its last blocks, can be past initial block download yet below the index. Same chain means the node
+     * knows the index's last block among its headers; a node on another chain (the SHA256 and BLAKE2b chains share every block below
+     * 961640) does not, and the check after this reports it.
+     */
+    private void waitForNodeToReach(int markerHeight, byte[] storedHash, BlockchainInfo blockchainInfo) {
+        if(blockchainInfo.blocks() >= markerHeight) {
+            return;
+        }
+        try {
+            getBitcoindService().getBlockHeader(Sha256Hash.wrap(storedHash).toString());
+        } catch(JsonRpcException e) {
+            return; //not a header the node knows
+        }
+        log.info("The node is at block {}, behind this index (block {}) on the same chain: waiting for it to catch up", blockchainInfo.blocks(), markerHeight);
+        while(!stopped && getBitcoindService().getBlockchainInfo().blocks() < markerHeight) {
+            try {
+                Thread.sleep(10_000);
+            } catch(InterruptedException e) {
+                Thread.currentThread().interrupt();
+                return;
+            }
+        }
+    }
+
     /**
      * The tip as wallets receive it from blockchain.headers.subscribe: the node's own serialization of the header, at whatever
      * length it has (80 bytes, or 164 for a v2 header on the BLAKE2b chain), rather than one rebuilt from getblockheader's JSON
