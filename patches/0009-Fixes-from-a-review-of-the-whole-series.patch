+    /**
+     * @return the backend's version, raised to bound (atLeast) or lowered to it, or bound itself if the backend's is missing or unreadable
+     */
+    private static String clamp(String backend, Version bound, boolean atLeast) {
+        try {
+            if(backend == null) {
+                return bound.get();
+            }
+            int cmp = new Version(backend).compareTo(bound);
+            return (atLeast ? cmp < 0 : cmp > 0) ? bound.get() : backend;
+        } catch(RuntimeException e) {
+            return bound.get();
+        }
+    }
