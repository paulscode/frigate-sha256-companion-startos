+    @Test
+    public void aCachedFutureWitnessPrevoutStillSkipsTheTransaction() {
+        Config.setInstance(new Config());
+        BitcoindClient client = new BitcoindClient(null, null, new BitcoindTransport(new Server("http://127.0.0.1:1"), "user:pass"));
+        Sha256Hash parent = Sha256Hash.wrap("11".repeat(32));
+        byte[] v2 = HexFormat.of().parseHex("5220" + "22".repeat(32));
+        byte[] unknown = HexFormat.of().parseHex("6a0401020304");
+        client.addtoScriptPubKeyCache(parent, 0, v2);
+        client.addtoScriptPubKeyCache(parent, 1, unknown);
