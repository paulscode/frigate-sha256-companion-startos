+package com.sparrowwallet.frigate.electrum;
+
+import com.sparrowwallet.drongo.protocol.BlockHeader;
+import org.junit.jupiter.api.Test;
+
+import java.util.HexFormat;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * Real mainnet headers either side of the BLAKE2b activation at 961640, read from a knots-blake2b node with
+ * getblockheader &lt;hash&gt; false. The last legacy header is 80 bytes and SHA256d-hashed; the first v2 header is 164 bytes and
+ * BLAKE2b-hashed, and getblockheader's JSON for it reports version 0x20000000 with bit 31 cleared, which is why the length has
+ * to come from the raw header rather than the JSON.
+ */
+public class ElectrumBlockHeaderTest {
