+package com.sparrowwallet.frigate.bitcoind;
+
+import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
+
+/**
+ * The part of gettxout's answer Frigate reads. gettxout answers from the node's UTXO set, which a pruned node keeps in full, so it
+ * finds the output a mempool transaction spends without -txindex. It answers null for an output that is spent, or that never existed.
+ */
+@JsonIgnoreProperties(ignoreUnknown = true)
+public record TxOut(String bestblock, Integer confirmations, ScriptPubKey scriptPubKey) {
+    @JsonIgnoreProperties(ignoreUnknown = true)
+    public record ScriptPubKey(String hex) {}
+}
