@@ -0,0 +1,26 @@
+package com.sparrowwallet.frigate.bitcoind;
+
+/**
+ * A block the index needs is one the node has pruned, together with the undo data that holds its spent outputs. Silent Payments
+ * need those outputs, and no peer can supply them, so the index cannot continue past this block. Never skipped: a gap in the index
+ * is a payment a wallet would silently not see.
+ */
+public class PrunedBlockException extends RuntimeException {
+    private final int height;
+    private final int pruneHeight;
+
+    public PrunedBlockException(int height, int pruneHeight, Throwable cause) {
+        super("The node has pruned block " + height + " (it now keeps blocks from " + pruneHeight + "), which this index still needs. " +
+                "Rebuild the index to start it again from the node's prune height, or raise the node's prune target so it keeps more blocks.", cause);
+        this.height = height;
+        this.pruneHeight = pruneHeight;
+    }
+
+    public int getHeight() {
+        return height;
+    }
+
+    public int getPruneHeight() {
+        return pruneHeight;
+    }
+}
