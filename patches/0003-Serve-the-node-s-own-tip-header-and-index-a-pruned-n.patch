 package com.sparrowwallet.frigate.electrum;
 
+import com.fasterxml.jackson.annotation.JsonIgnore;
+
 public record ElectrumBlockHeader(int height, String hex) {
+    /**
+     * Bit 31 of the version field marks a v2 header (164 bytes, BLAKE2b proof of work). The version is the first four bytes,
+     * little endian, so the bit is the top bit of the fourth byte.
+     *
+     * @param hex a serialized block header
+     * @return true if it is a v2 header, read from its version field, which is how a header says how long it is
+     */
+    public static boolean isV2(String hex) {
+        if(hex == null || hex.length() < 8) {
+            return false;
+        }
+        int lastVersionByte = Integer.parseInt(hex.substring(6, 8), 16);
+        return (lastVersionByte & 0x80) != 0;
+    }
 
+    @JsonIgnore //not part of the header as sent to wallets
+    public boolean isV2() {
+        return isV2(hex);
+    }
 }
